---
import { Image } from "astro:assets";
import logoRvoe from "../assets/images/logo-rvoe.svg";
import logoSep from "../assets/images/logo-sep.svg";
import { socialLinks, legalLink } from "../data/site";
---

<footer class="fixed inset-x-0 bottom-0 -z-10 bg-black text-white" data-footer>

  <div class="mx-auto max-w-[1740px] px-6 py-2 md:px-12 lg:px-20">
    <div class="mt-20 mb-5 flex flex-wrap items-center justify-between gap-8 md:mt-40">
      <div class="flex items-center gap-6">
        <Image src={logoRvoe} alt="RVOE" class="h-10 w-auto" />
        <Image src={logoSep} alt="SEP" class="h-10 w-auto" />
      </div>

      <nav aria-label="Redes sociales">
        <ul class="flex flex-wrap items-center gap-6 font-heading text-xl tracking-widest md:gap-10 md:text-3xl">
          {socialLinks.map(({ label, href }) => (
            <li>
              <a href={href} class="hover:underline focus-visible:underline">{label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <a href={legalLink.href} class="mt-3 font-sans text-base tracking-wider underline">
        {legalLink.label}
      </a>
    </div>
  </div>
</footer>

<script>
  import "../scripts/footer-reveal";
</script>