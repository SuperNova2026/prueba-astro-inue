---
// src/components/Institutional.astro
import { Image } from 'astro:assets';
import trustImage from '../assets/images/trust.webp';
---

<section class="flex flex-col lg:min-h-200 lg:flex-row">
    <div
        class="flex flex-col justify-between gap-10 bg-yellow p-6 text-black
		md:p-14 lg:w-2/5 lg:shrink-0 lg:bg-black lg:p-[3vw] lg:text-white"
    >
        <div>
            <p class="font-light lg:text-white">INUE Universidad</p>
            <h2
                class="mt-2 text-3xl font-bold uppercase leading-tight text-black
				md:mt-6 lg:text-[3vw] lg:whitespace-nowrap lg:text-yellow"
            >
                <span class="lg:block"> Educación para una </span> <span class="lg:block"> vida en movimiento </span>
            </h2>
        </div>

        <div>
            <p class="text-base font-lightlg:text-lg lg:text-white">
                Con más de <span class="lg:text-yellow"> 30 años </span>
                formando profesionistas preparados para un mundo en constante cambio: con
                habilidades digitales sólidas, pensamiento estratégico, capacidad de análisis
                y creatividad para <span class="lg:text-yellow"> transformar </span>
                obstáculos en oportunidades.
            </p>
        </div>
    </div>

    <div class="relative lg:w-3/5">
        <Image
            src={trustImage}
            alt="Graduacion en INUE Universidad"
            loading="lazy"
            decoding="async"
            class="h-auto w-full lg:absolute lg:inset-0 lg:h-full lg:object-cover lg:object-center"
        />
    </div>
</section>