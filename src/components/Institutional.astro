---
import { Image } from 'astro:assets';
import trustImage from '../assets/images/trust.webp';
---

<section class="flex flex-col lg:min-h-150 lg:flex-row">
    <!-- Panel de texto: ancho fijo en pg -->
    <div
        class="flex flex-col justify-between gap-10 bg-brand p-6 text-black
               lg:w-136 lg:shrink-0 lg:bg-black lg:p-12 lg:text-white"
    >
        <div>
            <p class="text-sm font-semibold text-black lg:text-white">INUE Universidad</p>
            <h2 class="mt-2 text-3xl font-extrabold uppercase text-black lg:text-5xl lg:text-brand">
                Educación para una vida en movimiento
            </h2>
        </div>

        <div>
            <p class="text-base text-black lg:text-lg lg:text-white">
                Con más de
                <span class=" lg:text-brand">30 años</span>
                formando profesionistas preparados para un mundo en constante cambio: con
                habilidades digitales sólidas, pensamiento estratégico, capacidad de análisis
                y creatividad para
                <span class=" lg:text-brand">transformar</span>
                obstáculos en oportunidades.
            </p>
        </div>
    </div>

    <!-- Contenedor de imagen: ocupa el espacio restante en pg -->
    <div class="relative lg:min-w-0 lg:flex-1">
        <Image
            src={trustImage}
            alt="Graduacion en INUE Universidad"
            loading="lazy"
            decoding="async"
            class="h-auto w-full lg:absolute lg:inset-0 lg:h-full lg:object-cover lg:object-center"
        />
    </div>
</section>