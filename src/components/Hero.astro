---
import { Image } from "astro:assets";
import heroImage from "../assets/images/index-hero.webp";

import LogoRVOE from '../assets/images/logo-rvoe.svg';
import LogoSEP from '../assets/images/logo-sep.svg';

import { highschoolLink, bachelorLink, masterLink, doctorateLink } from "../data/links";

import { ArrowRight } from "@lucide/astro";
---

<section class="flex min-h-[calc(100vh-91px)] flex-col">
    <div class="relative isolate flex flex-1 items-center overflow-hidden bg-black text-white max-h-80 md:max-h-140 min-[1400px]:max-h-110">
		<Image
			src={heroImage}
			alt="Hero INUE Universidad"
			loading="eager"
			decoding="async"
			fetchpriority="high"
			class="absolute inset-0 -z-10 h-full w-full object-cover bg-black brightness-75"
		/>

		<div class="absolute top-8 left-6 flex items-center gap-6 md:left-12 lg:left-20">
			<LogoSEP class="h-8 w-auto" />
			<LogoRVOE class="h-8 w-auto" />
		</div>

		<div class="mx-auto w-full max-w-[1740px] px-6 py-24 md:px-12 lg:px-20 lg:py-32">
			<h1 class="max-w-5xl font-heading text-2xl md:text-8xl uppercase mt-10">Educación que no tiene límites</h1>
			<p class="mt-2 max-w-3xl font-sans text-xs md:text-lg font-normal">
				Bachillerato, licenciatura y posgrados con validez oficial ante la SEP.
				<span class="hidden md:block">
					Te acompañamos durante toda tu carrera, desde tu inscripción hasta tu titulación.
				</span>
			</p>
		</div>
	</div>

    <div class="bg-yellow text-black grid grid-cols-1 lg:h-100 lg:grid-cols-3">
        <h2 class="sr-only">Nuestros programas</h2>

        <a href={highschoolLink.href} class="group flex items-start justify-between gap-6 bg-yellow p-9 text-black">
            <div>
                <h3 class="font-sans text-2xl md:text-3xl font-medium">Bachillerato</h3>
                <p class="mt-3 font-sans text-lg md:text-xl">Gradúate en 2 años</p>
            </div>
            <ArrowRight class="h-10 w-10 transition-transform duration-200 ease-out group-hover:translate-x-1"/>
        </a>

        <a href={bachelorLink.href} class="group flex items-start justify-between gap-6 border-t border-black bg-yellow p-9 text-black lg:border-t-0 lg:border-l">
            <div>
                <h3 class="font-sans text-2xl md:text-3xl font-medium">Licenciatura</h3>
                <p class="mt-3 font-sans text-lg md:text-xl">Gradúate en 3 años</p>
            </div>
            <ArrowRight class="h-10 w-10 transition-transform duration-200 ease-out group-hover:translate-x-1"/>
        </a>

        <div class="bg-black text-white font-sans text-2xl md:text-3xl font-medium grid grid-rows-2">
            <h3 class="sr-only">Posgrado</h3>

            <a href={masterLink.href} class="group flex items-start justify-between gap-6 p-9">
                <div>
                    <h3 class="font-sans text-2xl font-medium md:text-3xl">Maestría</h3>
                    <p class="mt-2 font-sans text-base md:text-lg">Profundiza tu especialidad</p>
                </div>
                <ArrowRight class="h-10 w-10 transition-transform duration-200 ease-out group-hover:translate-x-1"/>
            </a>

            <a href={doctorateLink.href} class="group flex items-start justify-between gap-6 border-t border-white/30 p-9">
                <div>
                    <h3 class="font-sans text-2xl font-medium md:text-3xl">Doctorado</h3>
                    <p class="mt-2 font-sans text-base md:text-lg">Lidera la transformación educativa</p>
                </div>
                <ArrowRight class="h-10 w-10 transition-transform duration-200 ease-out group-hover:translate-x-1"/>
            </a>
        </div>
    </div>
</section>