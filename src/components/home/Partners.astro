---
import { Image } from "astro:assets";
import { partnersTop, partnersBottom } from "../../data/partners.ts";

const topRow = [...partnersTop, ...partnersTop];
const bottomRow = [...partnersBottom, ...partnersBottom];
---

<section class="bg-black text-white">
	<div class="mx-auto max-w-[1740px] px-6 py-24 md:px-12 lg:px-20">
		<div class="mt-10 md:mt-20 lg:mt-25">
			<h2 class="text-center font-heading text-[clamp(2rem,7vw,96px)] leading-[1.05] uppercase">
				Cientos de oportunidades
			</h2>
			<p class="mt-4 text-center font-sans text-base md:mt-6 md:text-2xl">
				Instituciones que confían en INUE y sus egresados
			</p>
			<div class="mt-12 mb-10 md:mt-28 md:mb-20">
				<div class="relative ml-[calc(50%-50vw)] w-screen space-y-12 overflow-hidden">
					<div class="flex w-max animate-[marquee_60s_linear_infinite] gap-20">
					{topRow.map((logo, i) => (
						<Image
						src={logo.image}
						alt={i < partnersTop.length ? logo.alt : ""}
						loading="lazy"
						class="h-24 w-auto max-w-none object-contain brightness-0 invert"
						/>
					))}
					</div>
					
					<div class="flex w-max animate-[marquee_60s_linear_infinite] [animation-direction:reverse] gap-20">
					{bottomRow.map((logo, i) => (
						<Image
						src={logo.image}
						alt={i < partnersBottom.length ? logo.alt : ""}
						loading="lazy"
						class="h-24 w-auto max-w-none object-contain brightness-0 invert"
						/>
					))}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes marquee {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}
</style>