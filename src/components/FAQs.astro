---
import { Image } from "astro:assets";
import faqImage from "../assets/images/faqs-bachelors.webp";

import { faqList } from "../data/faqs.ts";

import { Plus } from "@lucide/astro";
---

<section class="bg-white">
    <div class="grid grid-cols-1 lg:grid-cols-2">
        <div class="flex flex-col">
            <div class="px-6 pt-6 md:px-10 md:pt-10 lg:px-12 lg:pt-12">
                <h2 class="max-w-2xl font-heading text-[clamp(2rem,4.5vw,64px)] leading-[1.05] uppercase">
                    Preguntas frecuentes
                </h2>
            </div>

            <div class="mt-6 divide-y divide-black border-y border-black md:mt-10">
                {faqList.map((item, i) => (
                    <details class="group/faq faq-item" name="usecases" open={i === 0}>
                        <summary class="group/summary usecase-summary relative isolate flex cursor-pointer list-none items-center justify-between gap-4 overflow-hidden bg-white px-6 py-5 font-sans text-base transition-colors duration-300 hover:text-white group-open/faq:bg-yellow group-open/faq:font-medium group-open/faq:transition-none group-open/faq:hover:text-black md:gap-6 md:px-10 md:py-7 md:text-2xl lg:px-12">
                            <span class="relative z-10">{item.question}</span>

                            <span class="relative z-10 grid h-8 w-8 shrink-0 place-items-center md:h-9 md:w-9">
                                <Plus aria-hidden="true" class="h-6 w-6 stroke-2 transition-transform duration-300 ease-in-out group-open/faq:rotate-45 md:h-7 md:w-7" />
                            </span>
							
                            <span aria-hidden="true" class="pointer-events-none absolute top-1/2 left-1/2 z-0 size-[200vmax] -translate-x-1/2 -translate-y-1/2 scale-0 rounded-full bg-black transition-transform duration-500 ease-in-out group-hover/summary:scale-100 group-open/faq:opacity-0 motion-reduce:transition-none"></span>
                        </summary>
                        <div class="usecase-body bg-yellow">
                            <div class="overflow-hidden">
                                <p class="px-6 pb-5 font-sans text-sm md:px-10 md:pb-7 md:text-xl lg:px-12">{item.answer}</p>
                            </div>
                        </div>
                    </details>
                ))}
            </div>
        </div>
        <Image
            src={faqImage}
            alt="Estudiantes de licenciatura INUE"
            loading="lazy"
            class="min-h-65 w-full object-cover md:min-h-100 lg:min-h-full"
        />
    </div>
</section>