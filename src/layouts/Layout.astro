---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es-MX">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@200..800&display=swap"
            media="print"
            onload="this.media='all'"
        /><noscript>
            <link
                rel="stylesheet"
                href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@200..800&display=swap"
            />
        </noscript>
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    </head>

    <body
        class="m-0 w-full h-full"
        class="isolate bg-white font-sans text-black antialiased"
    >
        <main class="relative bg-white mb-(--footer-height,0px)">
            <slot />
        </main>

        <Footer />
    </body>
</html>
